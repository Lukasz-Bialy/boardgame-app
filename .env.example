# ── Sekret do podpisywania sesji (ciasteczko logowania) ──
# Wygeneruj losowy ciąg, np.: openssl rand -base64 32
AUTH_SECRET=zmien-mnie-na-dlugi-losowy-ciag

# ── Baza danych ──
# LOKALNIE (domyślnie): zwykomentuj poniższe, a użyty zostanie plik local.db
# PRODUKCJA (Vercel) — Turso:
#   1. Zainstaluj Turso CLI i zrób: turso db create planszowki
#   2. turso db show planszowki --url        -> wklej jako DATABASE_URL
#   3. turso db tokens create planszowki     -> wklej jako DATABASE_AUTH_TOKEN
# DATABASE_URL=libsql://twoja-baza.turso.io
# DATABASE_AUTH_TOKEN=...

# ── Hasła użytkowników (opcjonalne nadpisanie domyślnych) ──
# Jeśli nie ustawisz, użyte zostaną domyślne z src/lib/users.ts
# To tylko hasła startowe — gdy użytkownik zmieni hasło w aplikacji, obowiązuje hash z bazy (tabela user_passwords)
# PW_BULCZY=PW_BULCZY
# PW_CHLEBOLDI=PW_CHLEBOLDI
# PW_ELDORIDA=PW_ELDORIDA
# PW_VRENSHRRGN=PW_VRENSHRRGN
# PW_ENTEY=PW_ENTEY

# ── Riot Games API (zakładka Liga) ──
# Klucz z https://developer.riotgames.com (klucz deweloperski wygasa po 24 h)
RIOT_API_KEY=${RIOT_API_KEY}

# ── Czat ekipy — kanał z serwera Discord (WidgetBot) ──
# 1. Dodaj bota WidgetBot na serwer: https://add.widgetbot.io
# 2. W Discordzie włącz Ustawienia → Zaawansowane → Tryb dewelopera
# 3. PPM na serwer → „Kopiuj ID serwera”, PPM na kanał → „Kopiuj ID kanału”
DISCORD_SERVER_ID=${DISCORD_SERVER_ID}
DISCORD_CHANNEL_ID=${DISCORD_CHANNEL_ID}

# ── Przygoda: AI jako Mistrz Gry (Google Gemini) ──
# Darmowy klucz: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcjonalnie inny model na pierwszą próbę. Domyślnie gemini-3.6-flash; przy przeciążeniu (503) lub limicie (429)
# aplikacja sama próbuje: gemini-flash-latest → gemini-3.5-flash → gemini-flash-lite-latest
# GEMINI_MODEL=gemini-3.5-flash

# ── Przygoda: obrazki AI (portrety, sceny, mapy) — wystarczy JEDEN dostawca ──
# Bez żadnego aplikacja pokazuje proceduralne grafiki zastępcze.
# 1) Cloudflare Workers AI (darmowy dzienny limit, model FLUX schnell) — polecane:
#    dash.cloudflare.com → prawy górny róg: Account ID; My Profile → API Tokens → szablon „Workers AI”
# CF_ACCOUNT_ID=
# CF_API_TOKEN=
# 2) Pollinations — klucz sk_ z https://enter.pollinations.ai
# POLLINATIONS_KEY=
# 3) Gemini (ten sam GEMINI_API_KEY) — generowanie obrazów zwykle wymaga płatnego planu
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Pick'em: klucz nieoficjalnego API lolesports.com (opcjonalnie — domyślnie publiczny klucz z ich strony)
# LOLESPORTS_API_KEY=
