# ── Sekret do podpisywania sesji (ciasteczko logowania) ──
# Wygeneruj losowy ciąg, np.: openssl rand -base64 32
AUTH_SECRET=zmien-mnie-na-dlugi-losowy-ciag

# ── Baza danych ──
# LOKALNIE (domyślnie): zwykomentuj poniższe, a użyty zostanie plik local.db
# PRODUKCJA (Vercel) — Turso:
#   1. Zainstaluj Turso CLI i zrób: turso db create planszowki
#   2. turso db show planszowki --url        -> wklej jako DATABASE_URL
#   3. turso db tokens create planszowki     -> wklej jako DATABASE_AUTH_TOKEN
# DATABASE_URL=libsql://twoja-baza.turso.io
# DATABASE_AUTH_TOKEN=...

# ── Hasła użytkowników (opcjonalne nadpisanie domyślnych) ──
# Jeśli nie ustawisz, użyte zostaną domyślne z src/lib/users.ts
# PW_BULCZY=
# PW_CHLEBOLDI=
# PW_ELDORIDA=
# PW_VRENSHRRGN=
# PW_ENTEY=
